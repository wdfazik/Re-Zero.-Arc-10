{
  "_comment": "Словарь автоподсветки терминов для scripts/import_chapter.py. Правила применяются автоматически при импорте нового .txt (с сохранением регистра и без двойного оборачивания). Можно свободно дополнять.",
  "rules": [
    {
      "tag": "sword",
      "description": "Драконий Меч Рейд (синий курсив)",
      "patterns": [
        "Дракони(?:й|его|ему|им|ем)\\s+Меч(?:а|у|ом|е)?(?:\\s+Рейд(?:а|у|ом|е)?)?",
        "Драконь(?:его|ему|им|ем)\\s+Меч(?:а|у|ом|е)?(?:\\s+Рейд(?:а|у|ом|е)?)?"
      ]
    },
    {
      "tag": "cult",
      "description": "Культ Ведьмы, Полномочия, Любимые Дети, Проклятые Печати (фиолетовый)",
      "patterns": [
        "Культ(?:а|у|ом|е)?\\s+Ведьм[ыаеу]?",
        "Архиепископ(?:а|у|ом|е|ы|ов|ам|ами|ах)?\\s+(?:Греха\\s+)?(?:Похоти|Лени|Чревоугодия|Гнева|Жадности|Гордыни|Уныния|Греха)",
        "Полномочи(?:е|я|ю|ем|и|й|ям|ями|ях)(?:\\s+(?:Похоти|Лени|Чревоугодия|Гнева|Жадности|Гордыни|Уныния))?",
        "Любим(?:ые|ых|ым|ыми)\\s+Дет(?:и|ей|ям|ьми|ях)",
        "Любим(?:ое|ого|ому|ым|ом)\\s+Дит(?:я|яти|ём|ем)",
        "Проклят(?:ая|ой|ую|ою|ые|ых|ым|ыми)\\s+Печат(?:ь|и|ью|ей|ям|ями|ях)",
        "Невидим(?:ое|ого|ому|ым|ом)\\s+Провидени(?:е|я|ю|ем|и)",
        "Ведьмак(?:а|у|ом|е)?\\s+Уныния",
        "Дурн(?:ой|ого|ому|ым|ом)\\s+Глаз(?:а|у|ом|е)?"
      ]
    },
    {
      "tag": "dragon",
      "description": "Божественный Дракон, Таинство, Глаз Дракона, Божественные Защиты (золотой)",
      "patterns": [
        "Церк(?:овь|ви|овью|вью)\\s+Божественного\\s+Дракона",
        "Божественн(?:ый|ого|ому|ым|ом)\\s+Дракон(?:а|у|ом|е)?",
        "Глаз(?:а|у|ом|е)?\\s+Дракона",
        "Таинств(?:о|а|у|ом|е)",
        "Небесн(?:ая|ой|ую|ою)\\s+Сфер(?:а|ы|е|у|ой)",
        "Божественн(?:ая|ой|ую|ою|ые|ых|ым|ыми)\\s+Защит(?:а|ы|е|у|ой|ам|ами|ах)(?:\\s+Святого\\s+Меча)?"
      ]
    },
    {
      "tag": "tongues",
      "description": "Шесть Языков (золотой)",
      "patterns": [
        "Шест(?:ь|и|ью)\\s+Язык(?:ов|ам|ами|ах|а)"
      ]
    },
    {
      "tag": "kingdom",
      "description": "Королевские Выборы, Совет Мудрецов, Королевская Гвардия (золотой)",
      "patterns": [
        "Королевск(?:ие|их|им|ими)\\s+Выбор(?:ы|ов|ам|ами|ах)",
        "Совет(?:а|у|ом|е)?\\s+Мудрецов",
        "Королевск(?:ая|ой|ую|ою)\\s+Гварди(?:я|и|ю|ей)"
      ]
    }
  ]
}
